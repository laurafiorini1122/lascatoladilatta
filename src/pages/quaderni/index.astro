---
import Base from '../../layouts/Base.astro';
import SchedaVolume from '../../components/SchedaVolume.astro';
import { volumiInOrdine } from '../../volumi';

const volumi = await volumiInOrdine();
---

<Base
  titolo="I quaderni della collana La scatola di latta"
  descrizione="I quaderni da colorare dedicati ai giochi dei bambini e delle bambine degli anni '50 e '60, con le pagine per scrivere i ricordi di allora."
  percorso="/quaderni/"
>
  <div class="contenitore centrato">
    <h1>I quaderni</h1>
    <p class="introduzione">
      I primi due quaderni sono dedicati ai giochi: quelli dei bambini in <strong>Calzoni corti</strong>,
      quelli delle bambine in <strong>Trecce e fiocchi</strong>.<br />
      Altri volumi sono in preparazione.
    </p>
    <div class="elenco">
      {volumi.map((volume) => <SchedaVolume volume={volume} livello="h2" />)}
    </div>
    <p class="introduzione in-preparazione">
      In preparazione altri quaderni: la scuola, la casa, la cucina, le feste e altri giochi.
    </p>
  </div>
</Base>

<style>
  .centrato {
    text-align: center;
  }
  .introduzione {
    max-width: 40rem;
    margin-inline: auto;
  }
  .in-preparazione {
    margin-top: 2.5rem;
  }
  .elenco {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    margin-top: 2rem;
  }
  .elenco > :global(*) {
    flex: 0 1 21rem;
  }
  .elenco :global(h2) {
    margin-top: 0;
    font-size: 1.5rem;
  }
</style>
