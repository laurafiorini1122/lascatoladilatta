---
// Esempi colorati e pagina da provare: le due cose promesse dal retro di
// copertina, riunite in una sola pagina con il tamburello, che non compare
// in nessun quaderno.
import Base from '../../layouts/Base.astro';
import { PAGINA_DI_PROVA, url } from '../../sito';

// Le tre versioni colorate, preparate da scripts/prepara_immagini.py.
const versioni = [
  {
    titolo: 'Con le matite colorate',
    file: 'matite',
    alt: 'Il tamburello colorato con le matite',
  },
  {
    titolo: 'Con i pennarelli',
    file: 'pennarelli',
    alt: 'Il tamburello colorato con i pennarelli e decorato a cerchietti',
  },
  {
    titolo: 'Con uno sfondo decorativo',
    file: 'sfondo',
    alt: 'Il tamburello colorato con le matite, con uno sfondo di righe ondulate',
  },
];
const immagine = (file: string, w: number) => url(`/immagini/prova/tamburello-${file}-${w}.webp`);
---

<Base
  titolo="Esempi colorati e una pagina da provare da stampare"
  descrizione="La pagina del tamburello colorata in modi diversi, da scaricare e stampare su due fogli A4 per provare a colorare e a scrivere il ricordo."
  percorso="/prova/"
>
  <div class="contenitore centrato">
    <section class="apertura">
      <h1>Esempi colorati e una pagina da provare</h1>
      <p class="introduzione">
        Prima di scegliere un quaderno puoi vedere com'è fatta una pagina e provarla.<br />
        È dedicata al tamburello, il gioco con la racchetta di pelle.<br />
        Non è in nessun quaderno, così non la ritroverai uguale nel libro.
      </p>
    </section>

    <section aria-labelledby="colorata">
      <h2 id="colorata">La stessa pagina, colorata in modi diversi</h2>
      <ul class="versioni">
        {
          versioni.map((v) => (
            <li>
              <p>{v.titolo}</p>
              <img
                src={immagine(v.file, 600)}
                srcset={`${immagine(v.file, 600)} 600w, ${immagine(v.file, 1200)} 1200w`}
                sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 45vw, 100vw"
                alt={v.alt}
                width="600"
                height="777"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="breve" aria-labelledby="provala">
      <h2 id="provala">Ora prova tu</h2>
      <p>
        Scarica la pagina, stampala su due fogli A4 e prova a colorare il disegno e a scrivere il
        ricordo che ti fa venire in mente.
      </p>
      {
        PAGINA_DI_PROVA ? (
          <p>
            <a class="pulsante" href={url(PAGINA_DI_PROVA)} download>
              Scarica la pagina da provare (PDF, 2 pagine A4)
            </a>
          </p>
        ) : (
          <p class="avviso">La pagina da provare sarà disponibile a breve.</p>
        )
      }
      <h3>Per stampare bene</h3>
      <p>
        Usa carta bianca normale e, se la stampante lo chiede, scegli "dimensioni effettive" o
        "100%" invece di "adatta alla pagina". Se vuoi usare i pennarelli, stampa solo su un lato
        del foglio.
      </p>
    </section>
  </div>
</Base>

<style>
  .centrato {
    text-align: center;
  }
  section + section {
    margin-top: 4rem;
  }
  .apertura,
  .breve {
    max-width: 38rem;
    margin-inline: auto;
  }
  .versioni {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }
  .versioni li {
    flex: 1 1 15rem;
    max-width: 22rem;
  }
  .versioni p {
    margin: 0 0 0.75rem;
    font-weight: 700;
  }
  /* il disegno intero, senza ritagli, su un foglio con un'ombra leggera */
  .versioni img {
    display: block;
    width: 100%;
    height: auto;
    background: #fff;
    box-shadow: 0 2px 8px rgb(43 38 33 / 0.14);
  }
  .breve h3 {
    margin-top: 2.5rem;
  }
</style>
