---
// Esempi colorati e pagina da provare: le due cose promesse dal retro di
// copertina, riunite in una sola pagina con il tamburello, che non compare
// in nessun quaderno.
import Base from '../../layouts/Base.astro';
import { PAGINA_DI_PROVA, url } from '../../sito';

// Segnaposto finché non arrivano le versioni colorate della pagina di prova.
const versioni = [
  { titolo: 'Con le matite colorate' },
  { titolo: 'Con i pennarelli' },
  { titolo: 'Con uno sfondo decorativo' },
];
---

<Base
  titolo="Esempi colorati e una pagina da provare da stampare"
  descrizione="La pagina del tamburello colorata in modi diversi, da scaricare e stampare su un foglio A4 per provare a colorare e a scrivere il ricordo."
  percorso="/prova/"
>
  <div class="contenitore centrato">
    <section class="apertura">
      <h1>Esempi colorati e una pagina da provare</h1>
      <p class="introduzione">
        Prima di scegliere un quaderno puoi vedere com'è fatta una pagina e provarla. È dedicata
        al tamburello, il gioco con la racchetta di pelle. Non è in nessun quaderno, così non la
        ritroverai uguale nel libro.
      </p>
    </section>

    <section aria-labelledby="colorata">
      <h2 id="colorata">La stessa pagina, colorata in modi diversi</h2>
      <ul class="versioni">
        {
          versioni.map((v) => (
            <li>
              <div class="segnaposto">
                <span>
                  Il tamburello
                  <br />
                  (immagine in arrivo)
                </span>
              </div>
              <p>{v.titolo}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="breve" aria-labelledby="provala">
      <h2 id="provala">Ora prova tu</h2>
      <p>
        Scarica la pagina, stampala su un foglio A4 e prova a colorare il disegno e a scrivere il
        ricordo che ti fa venire in mente.
      </p>
      {
        PAGINA_DI_PROVA ? (
          <p>
            <a class="pulsante" href={url(PAGINA_DI_PROVA)} download>
              Scarica la pagina da provare (PDF)
            </a>
          </p>
        ) : (
          <p class="avviso">La pagina da provare sarà disponibile a breve.</p>
        )
      }
      <h3>Per stampare bene</h3>
      <p>
        Usa carta bianca normale e, se la stampante lo chiede, scegli "dimensioni effettive" o
        "100%" invece di "adatta alla pagina". Se vuoi usare i pennarelli, stampa solo su un lato
        del foglio.
      </p>
    </section>
  </div>
</Base>

<style>
  .centrato {
    text-align: center;
  }
  section + section {
    margin-top: 4rem;
  }
  .apertura,
  .breve {
    max-width: 38rem;
    margin-inline: auto;
  }
  .versioni {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }
  .versioni li {
    flex: 0 1 16rem;
  }
  .versioni p {
    margin: 0.75rem 0 0;
    font-weight: 700;
  }
  .breve h3 {
    margin-top: 2.5rem;
  }
</style>
