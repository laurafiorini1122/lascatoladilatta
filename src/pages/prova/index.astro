---
import Base from '../../layouts/Base.astro';
import { PAGINA_DI_PROVA, url } from '../../sito';

// Segnaposto finché non arrivano le versioni colorate della pagina di prova.
const versioni = [
  { titolo: 'Con le matite colorate' },
  { titolo: 'Con i pennarelli' },
  { titolo: 'Con uno sfondo decorativo' },
];
---

<Base
  titolo="Una pagina da provare, da stampare e colorare"
  descrizione="Scarica la pagina del tamburello, stampala su un foglio A4 e prova a colorare il disegno e a scrivere il ricordo, come nei quaderni La scatola di latta."
  percorso="/prova/"
>
  <div class="contenitore centrato">
    <section class="apertura">
      <h1>Una pagina da provare</h1>
      <p class="introduzione">
        Prima di scegliere un quaderno puoi provare com'è fatta una pagina. Scaricala, stampala su un
        foglio A4 e prova a colorare il disegno e a scrivere il ricordo che ti fa venire in
        mente.
      </p>
      <p>
        La pagina è dedicata al tamburello, il gioco con la racchetta di pelle. Non è in nessun
        quaderno, così non la ritroverai uguale nel libro.
      </p>
      {
        PAGINA_DI_PROVA ? (
          <p>
            <a class="pulsante" href={url(PAGINA_DI_PROVA)} download>
              Scarica la pagina da provare (PDF)
            </a>
          </p>
        ) : (
          <p class="avviso">La pagina da provare sarà disponibile a breve.</p>
        )
      }
    </section>

    <section aria-labelledby="colorata">
      <h2 id="colorata">La stessa pagina, colorata in modi diversi</h2>
      <ul class="versioni">
        {
          versioni.map((v) => (
            <li>
              <div class="segnaposto">
                <span>
                  Il tamburello
                  <br />
                  (immagine in arrivo)
                </span>
              </div>
              <p>{v.titolo}</p>
            </li>
          ))
        }
      </ul>
      <p>
        Altre pagine colorate le trovi negli <a href={url('/esempi/')}>esempi</a>.
      </p>
    </section>

    <section class="breve" aria-labelledby="stampare">
      <h2 id="stampare">Per stampare bene</h2>
      <p>
        Usa carta bianca normale e, se la stampante lo chiede, scegli "dimensioni effettive" o
        "100%" invece di "adatta alla pagina". Se vuoi usare i pennarelli, stampa solo su un lato
        del foglio.
      </p>
    </section>
  </div>
</Base>

<style>
  .centrato {
    text-align: center;
  }
  section + section {
    margin-top: 4rem;
  }
  .apertura,
  .breve {
    max-width: 38rem;
    margin-inline: auto;
  }
  .versioni {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }
  .versioni li {
    flex: 0 1 16rem;
  }
  .versioni p {
    margin: 0.75rem 0 0;
    font-weight: 700;
  }
</style>
